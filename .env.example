# Jira
JIRA_BASE_URL=https://your-team.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Test IT
TESTIT_BASE_URL=https://your-team.testit.software
TESTIT_TOKEN=
TESTIT_PROJECT_ID=

# OpenRouter (single key for all LLM calls; model selection lives in config/project.ts)
OPENROUTER_API_KEY=

# GitHub (used by triggers stage to open PRs and run CI dispatches)
GITHUB_TOKEN=

# Runtime
QA_ENV=dev
QA_HEADLESS=1
LOG_LEVEL=info
