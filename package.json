{
  "name": "qa-core",
  "version": "0.1.0",
  "description": "Portable QA automation template: Jira -> live pass -> TestIT drafts -> autotests. Triggered by Jira webhook + CI cron.",
  "type": "commonjs",
  "main": "src/cli.ts",
  "bin": {
    "qa": "./bin/qa.cjs"
  },
  "scripts": {
    "qa": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "test": "playwright test"
  },
  "keywords": ["qa", "automation", "jira", "playwright", "testit", "openrouter", "template"],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^17.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "allure-playwright": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
